<mvc:View
    id="projectDetailView"
    controllerName="psa.dash.dash.controller.ProjectDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">

    <Page
        id="pdProjectDetailPage"
        title="Project Details"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>

            <VBox
                id="pdMainContainer"
                class="sapUiMediumMargin">

                <!-- KPI Cards -->

                <HBox
                            id="kpiContainers"
                            justifyContent="Center"
                            alignItems="Center"
                            width="100%"
                            class="sapUiMediumMargin">

                   
                       <GenericTile
                            id="pdBudgetTile"
                            class="sapUiSmallMarginEnd"
                            header="Budget"
                            frameType="OneByOne">


                        <TileContent
                            id="pdBudgetTileContent">

                            <NumericContent
                                id="pdBudgetNumericContent"
                                value="{budgetAmount}" />

                        </TileContent>

                    </GenericTile>

                   <GenericTile
                        id="pdConsumedTile"
                        class="sapUiSmallMarginEnd"
                        header="Consumed"
                        frameType="OneByOne">

                        <TileContent
                            id="pdConsumedTileContent">

                            <NumericContent
                                id="pdConsumedNumericContent"
                                value="{budgetConsumedAmount}" />

                        </TileContent>

                    </GenericTile>

                    <GenericTile
                    id="pdRemainingTile"
                    class="sapUiSmallMarginEnd"
                    header="Remaining"
                    frameType="OneByOne">

                        <TileContent
                            id="pdRemainingTileContent">

                            <NumericContent
                                id="pdRemainingNumericContent"
                                value="{remainingAmount}" />

                        </TileContent>

                    </GenericTile>

                    <GenericTile
                    id="pdBillingRateTile"
                    class="sapUiSmallMarginEnd"
                    header="Billing Rate"
                    frameType="OneByOne">


                        <TileContent
                            id="pdBillingRateTileContent">

                            <NumericContent
                                id="pdBillingRateNumericContent"
                                value="{billingRatePerHour}" />

                        </TileContent>

                    </GenericTile>

                    <GenericTile
                    id="pdHoursTile"
                    class="sapUiSmallMarginEnd"
                    header="Hours"
                    frameType="OneByOne">

                        <TileContent
                            id="pdHoursTileContent">

                            <NumericContent
                                id="pdHoursNumericContent"
                                value="{consumedHours}" />

                        </TileContent>

                    </GenericTile>

                </HBox>
    <Toolbar id="projectActionToolbar">

    <Title
        id="projectTitle"
        text="{projectName}" />

    <ToolbarSpacer id="tb" />

    <Button
        id="btnActivate"
        text="Activate"
        type="Emphasized"
        visible="false"
        press="onActivateProject" />

    <Button
        id="btnPutOnHold"
        text="Put On Hold"
        visible="false"
        press="onHoldProject" />

    <Button
        id="btnComplete"
        text="Complete"
        visible="false"
        press="onCompleteProject" />

    <Button
        id="btnCancel"
        text="Cancel Project"
        type="Reject"
        visible="false"
        press="onCancelProject" />

</Toolbar>
                <!-- Tabs -->

                <IconTabBar
                    id="pdProjectIconTabBar">

                    <items>

                        <!-- Budget -->

